# Django
DJANGO_SECRET_KEY=
DEBUG=False
# Через запятую. Если не задать — берётся список по умолчанию из settings.py.
ALLOWED_HOSTS=cybernexvpn.ru,www.cybernexvpn.ru
BASE_URL=https://cybernexvpn.ru

# База. Django читает только DATABASE_URL. Остальные POSTGRES_* нужны, лишь если
# поднимаешь Postgres рядом контейнером — в compose его сейчас нет, БД внешняя.
DATABASE_URL=postgresql://{POSTGRES_USER}:{POSTGRES_PASSWORD}@localhost:5432/{POSTGRES_DB}

# Логи
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
DB_LOG_LEVEL=WARNING
STATIC_TARGET_PATH=./data/backend/static/

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# YooKassa. Используется OAuth-токен, shop_id и секретный ключ не нужны.
# Чек 54-ФЗ настраивается в админке: Nexvpn → Глобальные настройки.
YOOKASSA_OAUTH_TOKEN=
# Диапазоны из документации YooKassa — дефолт зашит в settings.py, здесь только
# если понадобится переопределить. Строгий режим включать после проверки логов:
# ошибка в TRUSTED_PROXY_COUNT при нём тихо убьёт приём платежей.
YOOKASSA_IP_CHECK_ENFORCE=False
# Сколько наших прокси перед Django. На проде это системный nginx — один.
TRUSTED_PROXY_COUNT=1

# Telegram
TG_BOT_TOKEN=
TG_BOT_URL=https://t.me/CyberNexVpnBot
# Этого пользователя режим техработ пропускает (переключается в админке).
TG_ADMIN_USER_ID=
SUPPORT_CONTACT=@cybernexvpn

# Ключ REST API (/api/v1/admin/...). Боту не нужен — он ходит в ORM напрямую.
ADMIN_API_KEY=

# Remnawave
PANEL_API_URL=
PANEL_API_TOKEN=
PANEL_API_TIMEOUT=15
# Тот же секрет, что WEBHOOK_SECRET_HEADER в .env панели (/opt/remnawave/.env).
# Панель шлёт события на POST /api/v1/remnawave/webhook/
REMNAWAVE_WEBHOOK_SECRET=

# Страница-мостик: открывает Happ или INCY с уже добавленной подпиской.
# Пусто — бот ведёт на штатную страницу подписки Remnawave.
CONNECT_BRIDGE_URL=https://sub-nex.com/connect

# Тарификация. Цены тарифов лежат в таблице Plan и правятся в админке.
DAYS_IN_PERIOD=30
TRIAL_DAYS=3
TRIAL_PLAN_DEVICES=3
REFERRAL_INVITER_DAYS=10
REFERRAL_INVITEE_DAYS=10

# Час (по TIME_ZONE), на который округляется вверх окончание подписки.
# При 20:00 все напоминания попадают в 08:00–20:00, без ночных пушей.
SUBSCRIPTION_EXPIRY_HOUR=20
# За сколько часов до окончания напоминать.
SUBSCRIPTION_REMINDER_HOURS=168,48,24,12,6,2,1

# Разовый перенос старой базы (миграция 0022)
LEGACY_CUTOFF_DATE=2026-08-03
LEGACY_MAX_DEVICES=10
LEGACY_NO_DEVICES_DAYS=30
LEGACY_NO_DEVICES_PLAN_DEVICES=3
LEGACY_MIN_DAYS=7
LEGACY_MAX_DAYS=180
LEGACY_UNLIMITED_BALANCE=1000
LEGACY_UNLIMITED_DAYS=3650
LEGACY_UNLIMITED_PLAN_DEVICES=10
